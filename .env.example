# API
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://trace:trace_dev_password@localhost:55432/trace
DATABASE_SSL=false
DB_SYNCHRONIZE=true
TRACE_POSTGRES_PORT=55432

# Use independent random values of at least 32 bytes outside development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Single-line Firebase service-account JSON. Leave empty to disable remote push.
FIREBASE_SERVICE_ACCOUNT_JSON=
